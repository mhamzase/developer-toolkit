{
  "manifest_version": 3,
  "name": "Developer Toolkit: JSON, JWT, Regex & More",
  "short_name": "Dev Toolkit",
  "version": "1.0.1",
  "description": "JSON formatter, JWT decoder & signer, regex tester, Base64, hashes, QR codes and more. Free, 100% offline, no tracking.",
  "action": {
    "default_title": "Open Developer Toolkit"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "system.display",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "omnibox": {
    "keyword": "dt"
  },
  "commands": {
    "open-toolkit": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Developer Toolkit"
    }
  }
}
