{
  "manifest_version": 3,
  "name": "Developer Toolkit: JSON, JWT, Regex & More",
  "short_name": "Dev Toolkit",
  "version": "1.0.0",
  "description": "Fast, private developer tools for the work you do every day. All local, always growing.",

  "action": {
    "default_title": "Open Developer Toolkit"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "permissions": ["storage", "system.display"],

  "host_permissions": [],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
