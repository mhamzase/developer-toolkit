{
  "manifest_version": 3,
  "name": "Developer Toolkit – Web Developer Tools",
  "short_name": "Dev Toolkit",
  "version": "1.0.0",
  "description": "Fast, privacy-friendly developer tools for JSON, JWT, encoding, UUIDs, timestamps and more. All processing is local.",

  "action": {
    "default_title": "Open Developer Toolkit"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "permissions": ["storage", "system.display"],

  "host_permissions": [],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
